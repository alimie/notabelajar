---
export interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, description, breadcrumbs } = Astro.props;
---

<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | NotaBelajar</title>
    <meta name="description" content={description || 'Nota pembelajaran sekolah Malaysia — SK & SMK'} />
    <link rel="icon" type="image/svg+xml" href="/notabelajar/favicon.svg" />

    <!-- Google Fonts: Inter + Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --w-color-primary: hsl(0, 0%, 5%);
        --w-color-primary-10: hsl(0, 0%, 12%);
        --w-color-primary-20: hsl(0, 0%, 25%);
        --w-color-primary-30: hsl(0, 0%, 44%);
        --w-color-primary-40: hsl(0, 0%, 68%);
        --w-color-primary-50: hsl(0, 0%, 80%);
        --w-color-primary-60: hsl(0, 0%, 92%);
        --w-color-primary-70: hsl(0, 0%, 97%);
        --w-color-info: hsl(200, 100%, 42%);
        --w-color-info-accent: hsl(200, 100%, 50%);
        --w-color-info-fg: hsl(0, 0%, 100%);
        --w-color-success: hsl(155, 60%, 28%);
        --w-color-success-accent: hsl(155, 65%, 40%);
        --w-color-success-fg: hsl(0, 0%, 100%);
        --w-color-warning: hsl(32, 90%, 40%);
        --w-color-warning-accent: hsl(32, 100%, 50%);
        --w-color-warning-fg: hsl(0, 0%, 100%);
        --w-color-alert: hsl(0, 70%, 40%);
        --w-color-alert-accent: hsl(0, 72%, 50%);
        --w-color-alert-fg: hsl(0, 0%, 100%);
        --w-color-overlay: hsla(0, 0%, 0%, 0.5);
        --sk: #059669;
        --sk-light: #d1fae5;
        --smk: #d97706;
        --smk-light: #fef3c7;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--w-color-primary);
        background: var(--w-color-primary-70);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* ── Header / Nav ── */
      .site-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        color: white;
        padding: 0;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 0 2px 16px rgba(0,0,0,0.12);
      }

      .site-header-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.5rem;
      }

      .site-header .logo-area {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: white;
      }

      .site-header .logo-area .logo-icon {
        font-size: 1.5rem;
        line-height: 1;
      }

      .site-header .logo-text {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-weight: 700;
        font-size: 1.3rem;
        letter-spacing: -0.02em;
      }

      .site-header .logo-sub {
        font-size: 0.75rem;
        opacity: 0.75;
        margin-top: -2px;
        font-weight: 500;
      }

      .site-header .nav-links {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }

      .site-header .nav-links a {
        color: white;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 0.4rem 0.85rem;
        border-radius: 8px;
        transition: background 0.2s;
      }

      .site-header .nav-links a:hover {
        background: rgba(255,255,255,0.15);
      }

      .nav-special {
        opacity: 0.7;
        font-size: 0.8rem;
      }

      /* ── Main content ── */
      main {
        flex: 1;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        width: 100%;
      }

      .page-header {
        margin-bottom: 2rem;
      }

      .page-header h1 {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-weight: 700;
        font-size: 1.75rem;
        letter-spacing: -0.02em;
        color: var(--w-color-primary);
        margin-top: 0.25rem;
      }

      /* ── Article content ── */
      .note-content {
        line-height: 1.8;
        font-size: 1rem;
        color: var(--w-color-primary-10);
      }

      .note-content h2 {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-weight: 700;
        font-size: 1.35rem;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.4rem;
        border-bottom: 2px solid var(--w-color-primary-50);
        color: var(--w-color-primary);
      }

      .note-content h3 {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-weight: 600;
        font-size: 1.1rem;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        color: var(--w-color-primary-10);
      }

      .note-content p {
        margin-bottom: 1rem;
      }

      .note-content ul, .note-content ol {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
      }

      .note-content li {
        margin-bottom: 0.3rem;
      }

      .note-content blockquote {
        border-left: 3px solid var(--w-color-info);
        background: var(--w-color-primary-60);
        padding: 0.75rem 1rem;
        margin: 1rem 0;
        border-radius: 0 8px 8px 0;
        color: var(--w-color-primary-10);
        font-style: italic;
      }

      .note-content code {
        background: var(--w-color-primary-60);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
      }

      .note-content pre {
        background: var(--w-color-primary-60);
        padding: 1rem;
        border-radius: 10px;
        overflow-x: auto;
        margin-bottom: 1rem;
        font-size: 0.9rem;
      }

      .note-content table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
        font-size: 0.92rem;
      }

      .note-content th {
        background: var(--w-color-primary-60);
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-weight: 600;
        text-align: left;
        padding: 0.6rem 0.75rem;
      }

      .note-content td {
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--w-color-primary-50);
      }

      .note-content strong {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-weight: 600;
        color: var(--w-color-primary);
      }

      .note-content hr {
        border: 0;
        height: 1px;
        background: var(--w-color-primary-50);
        margin: 1.5rem 0;
      }

      /* ── Tags ── */
      .tag {
        display: inline-block;
        background: var(--w-color-primary-60);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-size: 0.78rem;
        color: var(--w-color-primary-20);
        border: 1px solid var(--w-color-primary-50);
        font-weight: 500;
        transition: all 0.2s;
      }
      .tag:hover {
        background: var(--w-color-primary-50);
        color: var(--w-color-primary-10);
      }

      /* ── Responsive ── */
      @media (max-width: 640px) {
        .site-header-inner { padding: 0.6rem 1rem; }
        .site-header .logo-text { font-size: 1.1rem; }
        .site-header .nav-links a { font-size: 0.8rem; padding: 0.3rem 0.6rem; }
        main { padding: 1.25rem 1rem; }
        .page-header h1 { font-size: 1.4rem; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/notabelajar/" class="logo-area">
          <span class="logo-icon">📝</span>
          <div>
            <div class="logo-text">NotaBelajar</div>
            <div class="logo-sub">Nota Pembelajaran Malaysia</div>
          </div>
        </a>
        <nav class="nav-links">
          <a href="/notabelajar/sk">SK</a>
          <a href="/notabelajar/smk">SMK</a>
          <span class="nav-special">|</span>
          <a href="https://github.com/alimie/notabelajar" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:2px;"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.66-3.795-1.485-4.035-1.485-.675-1.71-1.65-2.175-1.65-2.175-1.35-.915.105-.915.105-.915 1.485.105 2.265 1.53 2.265 1.53 1.32 2.25 3.465 1.605 4.32 1.23.135-.96.51-1.605.93-1.965-3.33-.36-6.825-1.665-6.825-7.41 0-1.635.585-2.97 1.545-4.02-.15-.36-.675-1.89.15-3.93 0 0 1.26-.405 4.125 1.53 1.2-.33 2.475-.495 3.75-.495s2.55.165 3.75.495c2.865-1.92 4.125-1.53 4.125-1.53.825 2.04.3 3.57.15 3.93.96 1.05 1.545 2.385 1.545 4.02 0 5.76-3.51 7.035-6.84 7.41.54.465 1.02 1.38 1.02 2.775 0 2.01-.015 3.615-.015 3.945 0 .315.225.69.825.57C20.565 21.795 24 17.31 24 12 24 5.37 18.63 0 12 0z"/></svg>
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main>
      {breadcrumbs && breadcrumbs.length > 0 && (
        <nav style="font-size:0.85rem;margin-bottom:1rem;color:var(--w-color-primary-30);display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap;">
          {breadcrumbs.map((crumb, i) => (
            <>
              {i > 0 && <span style="color:var(--w-color-primary-40);font-size:0.7rem;">▸</span>}
              {crumb.href ? (
                <a href={crumb.href} style="color:var(--w-color-info);text-decoration:none;font-weight:500;">{crumb.label}</a>
              ) : (
                <span style="color:var(--w-color-primary-20);">{crumb.label}</span>
              )}
            </>
          ))}
        </nav>
      )}

      <div class="page-header">
        <h1>{title}</h1>
        {description && <p style="color:var(--w-color-primary-30);margin-top:0.3rem;font-size:0.95rem;">{description}</p>}
      </div>

      <slot />
    </main>

    <!-- Footer -->
    <footer style="background:var(--w-color-primary-60);border-top:1px solid var(--w-color-primary-50);padding:2rem 1.5rem;text-align:center;">
      <div style="max-width:1100px;margin:0 auto;">
        <div style="display:flex;justify-content:center;gap:1.5rem;flex-wrap:wrap;margin-bottom:1rem;">
          <a href="/notabelajar/" style="color:var(--w-color-info);text-decoration:none;font-size:0.85rem;font-weight:500;">Laman Utama</a>
          <a href="/notabelajar/sk" style="color:var(--w-color-info);text-decoration:none;font-size:0.85rem;font-weight:500;">SK</a>
          <a href="/notabelajar/smk" style="color:var(--w-color-info);text-decoration:none;font-size:0.85rem;font-weight:500;">SMK</a>
          <a href="https://github.com/alimie/notabelajar" target="_blank" rel="noopener" style="color:var(--w-color-info);text-decoration:none;font-size:0.85rem;font-weight:500;">GitHub</a>
        </div>
        <p style="color:var(--w-color-primary-30);font-size:0.85rem;">
          NotaBelajar — Nota pembelajaran untuk pelajar Malaysia
        </p>
        <p style="color:var(--w-color-primary-40);font-size:0.75rem;margin-top:0.3rem;">
          Dikemaskini secara berkala • Dibina dengan Astro + WebcoreUI
        </p>
      </div>
    </footer>
  </body>
</html>