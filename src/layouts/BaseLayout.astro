---
import { Menu, Footer } from 'webcoreui/astro';
import 'webcoreui/styles';

export interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, description, breadcrumbs } = Astro.props;

// ── Active state untuk menu berdasarkan URL ──
const currentPath = Astro.url.pathname;

const menuItems = [
  { href: '/notabelajar/', name: 'Utama', active: currentPath === '/notabelajar/' },
  { href: '/notabelajar/sk', name: 'Sekolah Rendah', active: currentPath.startsWith('/notabelajar/sk') },
  { href: '/notabelajar/smk', name: 'Sekolah Menengah', active: currentPath.startsWith('/notabelajar/smk') },
];

// ── Footer columns ──
const footerColumns = [
  {
    title: '🏫 Peringkat',
    items: [
      { href: '/notabelajar/sk', name: 'Sekolah Rendah (SK)' },
      { href: '/notabelajar/smk', name: 'Sekolah Menengah (SMK)' },
    ],
  },
  {
    title: '📚 Subjek Popular',
    items: [
      { href: '/notabelajar/sk/matematik', name: 'Matematik SK' },
      { href: '/notabelajar/sk/sains', name: 'Sains SK' },
      { href: '/notabelajar/smk/sains', name: 'Sains SMK' },
      { href: '/notabelajar/smk/sejarah', name: 'Sejarah SMK' },
    ],
  },
  {
    title: '🔗 Pautan',
    items: [
      { href: '/notabelajar/', name: 'Laman Utama' },
      { href: 'https://github.com/alimie/notabelajar', name: 'GitHub', target: '_blank' as const },
    ],
  },
];

const logoHtml = `<span style="display:flex;align-items:center;gap:0.6rem;">
  <span style="font-size:1.5rem;line-height:1;">📝</span>
  <div>
    <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:1.2rem;letter-spacing:-0.02em;color:#2F363F;">NotaBelajar</div>
    <div style="font-size:0.7rem;opacity:0.5;margin-top:-2px;font-weight:500;color:#7A8A8A;font-family:'Poppins',sans-serif;">Nota Pembelajaran Malaysia</div>
  </div>
</span>`;

const footerLogoHtml = `<span style="display:flex;align-items:center;gap:0.6rem;">
  <span style="font-size:1.3rem;line-height:1;">📝</span>
  <div>
    <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:-0.02em;color:#2F363F;">NotaBelajar</div>
  </div>
</span>`;
---

<!doctype html>
<html lang="ms" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | NotaBelajar</title>
    <meta name="description" content={description || 'Nota pembelajaran sekolah Malaysia — SK & SMK'} />
    <link rel="icon" type="image/svg+xml" href="/notabelajar/favicon.svg" />

    <!-- Google Fonts: Poppins + Outfit — NotaBelajar Ceramic theme -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Outfit:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ═══════════════════════════════════════
         NotaBelajar Ceramic Theme — CSS Variables
         ═══════════════════════════════════════ */
      :root {
        --ceramic-dark: #2F363F;
        --ceramic-peach: #E2A48A;
        --ceramic-terracotta: #C17559;
        --ceramic-ochre: #A38652;
        --ceramic-sage: #9DA394;
        --ceramic-cream: #E9D9C8;
        --ceramic-slate: #4A5D6A;
        --ceramic-teal: #3D5A5A;
        --ceramic-mauve: #6D5A6D;
        --ceramic-brick: #8B5D4E;

        --w-color-primary: var(--ceramic-dark);
        --w-color-primary-10: #3D4650;
        --w-color-primary-20: #4A5A6A;
        --w-color-primary-30: #7A8A8A;
        --w-color-primary-40: var(--ceramic-sage);
        --w-color-primary-50: #C9D4C8;
        --w-color-primary-60: var(--ceramic-cream);
        --w-color-primary-70: #F5EDE4;
        --w-color-info: var(--ceramic-slate);
        --w-color-info-accent: var(--ceramic-teal);
        --w-color-info-fg: #FFFFFF;
        --w-color-success: var(--ceramic-sage);
        --w-color-success-accent: var(--ceramic-ochre);
        --w-color-success-fg: #FFFFFF;
        --w-color-warning: var(--ceramic-peach);
        --w-color-warning-accent: var(--ceramic-terracotta);
        --w-color-warning-fg: #FFFFFF;
        --w-color-alert: var(--ceramic-brick);
        --w-color-alert-accent: var(--ceramic-terracotta);
        --w-color-overlay: rgba(47, 54, 63, 0.35);
        --sk: var(--ceramic-teal);
        --smk: var(--ceramic-mauve);
        --header-height: 64px;
      }

      html { scroll-behavior: smooth; }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Poppins', system-ui, -apple-system, sans-serif;
        color: var(--ceramic-dark);
        background: var(--ceramic-cream);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* ═══════════════════════════════════════
         Header — Glassmorphism (Ceramic)
         ═══════════════════════════════════════ */
      header[data-webcore-menu] {
        background: rgba(233, 217, 200, 0.7) !important;
        backdrop-filter: blur(14px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(14px) saturate(180%) !important;
        border-bottom: 1px solid rgba(47, 54, 63, 0.08) !important;
        padding: 0.7rem 1rem !important;
        box-shadow: 0 1px 8px rgba(193, 117, 89, 0.08) !important;
      }

      header[data-webcore-menu] ul {
        background: transparent !important;
        position: static !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: all !important;
        display: flex !important;
        flex-direction: row !important;
        gap: 0.25rem !important;
        box-shadow: none !important;
        transform: none !important;
      }

      header[data-webcore-menu] ul li a {
        font-size: 0.85rem !important;
        font-weight: 500 !important;
        padding: 0.45rem 1rem !important;
        border-radius: 8px !important;
        color: var(--ceramic-slate) !important;
        transition: all 0.2s ease !important;
        position: relative !important;
      }

      header[data-webcore-menu] ul li a:hover {
        background: rgba(193, 117, 89, 0.08) !important;
        color: var(--ceramic-terracotta) !important;
      }

      header[data-webcore-menu] ul li a.active {
        background: rgba(193, 117, 89, 0.10) !important;
        color: var(--ceramic-terracotta) !important;
        font-weight: 600 !important;
      }

      /* ── Hamburger button ── */
      header[data-webcore-menu] button[data-id="hamburger"] {
        display: none !important;
      }

      /* ── Mobile: slide-in drawer ── */
      @media (max-width: 799px) {
        header[data-webcore-menu] {
          padding: 0.6rem 1rem !important;
        }

        header[data-webcore-menu] button[data-id="hamburger"] {
          display: block !important;
          z-index: 999 !important;
        }

        header[data-webcore-menu] ul {
          position: fixed !important;
          top: 0 !important;
          left: auto !important;
          right: 0 !important;
          bottom: 0 !important;
          width: min(320px, 85vw) !important;
          flex-direction: column !important;
          gap: 0.25rem !important;
          padding: 5rem 1.5rem 2rem !important;
          background: rgba(245, 237, 228, 0.98) !important;
          backdrop-filter: blur(20px) !important;
          -webkit-backdrop-filter: blur(20px) !important;
          box-shadow: -8px 0 30px rgba(47, 54, 63, 0.1) !important;
          opacity: 0 !important;
          visibility: hidden !important;
          pointer-events: none !important;
          transition: opacity 0.35s ease, visibility 0.35s ease !important;
          z-index: 100 !important;
        }

        header[data-webcore-menu][data-active="true"] ul {
          opacity: 1 !important;
          visibility: visible !important;
          pointer-events: all !important;
        }

        header[data-webcore-menu] ul li a {
          font-size: 1rem !important;
          padding: 0.7rem 1rem !important;
          border-radius: 10px !important;
        }

        header[data-webcore-menu] ul li a.active {
          background: rgba(193, 117, 89, 0.12) !important;
        }
      }

      /* ═══════════════════════════════════════
         Main Content
         ═══════════════════════════════════════ */
      main {
        flex: 1;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        width: 100%;
        animation: fadeInUp 0.4s ease;
      }

      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .page-header { margin-bottom: 2rem; }

      .page-header h1 {
        font-family: 'Outfit', system-ui, sans-serif;
        font-weight: 700;
        font-size: 1.75rem;
        letter-spacing: -0.02em;
        color: var(--ceramic-dark);
        margin-top: 0.25rem;
      }

      /* ── Breadcrumb ── */
      .breadcrumb-nav {
        font-size: 0.85rem;
        margin-bottom: 1rem;
        color: var(--ceramic-sage);
        display: flex;
        gap: 0.4rem;
        align-items: center;
        flex-wrap: wrap;
      }
      .breadcrumb-nav a {
        color: var(--ceramic-slate);
        text-decoration: none;
        font-weight: 500;
        transition: opacity 0.2s;
      }
      .breadcrumb-nav a:hover { opacity: 0.7; }
      .breadcrumb-sep {
        color: var(--ceramic-sage);
        font-size: 0.65rem;
      }

      /* ═══════════════════════════════════════
         Note Content — Ceramic Styling
         ═══════════════════════════════════════ */
      .note-content {
        line-height: 1.8;
        font-size: 1rem;
        color: var(--ceramic-dark);
      }
      .note-content h2 {
        font-family: 'Outfit', system-ui, sans-serif;
        font-weight: 700;
        font-size: 1.35rem;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.4rem;
        border-bottom: 2px solid var(--ceramic-cream);
        color: var(--ceramic-terracotta);
      }
      .note-content h3 {
        font-family: 'Outfit', system-ui, sans-serif;
        font-weight: 600;
        font-size: 1.1rem;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        color: var(--ceramic-dark);
      }
      .note-content p { margin-bottom: 1rem; }
      .note-content ul, .note-content ol {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
      }
      .note-content li { margin-bottom: 0.3rem; }
      .note-content blockquote {
        border-left: 3px solid var(--ceramic-terracotta);
        background: rgba(193, 117, 89, 0.06);
        padding: 0.75rem 1rem;
        margin: 1rem 0;
        border-radius: 0 8px 8px 0;
        color: var(--ceramic-dark);
        font-style: italic;
      }
      .note-content code {
        background: rgba(233, 217, 200, 0.5);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
      }
      .note-content pre {
        background: rgba(233, 217, 200, 0.5);
        padding: 1rem;
        border-radius: 10px;
        overflow-x: auto;
        margin-bottom: 1rem;
        font-size: 0.9rem;
      }
      .note-content table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
        font-size: 0.92rem;
      }
      .note-content th {
        background: var(--ceramic-cream);
        font-family: 'Outfit', system-ui, sans-serif;
        font-weight: 600;
        text-align: left;
        padding: 0.6rem 0.75rem;
        color: var(--ceramic-dark);
      }
      .note-content td {
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid rgba(201, 212, 200, 0.7);
      }
      .note-content strong {
        font-family: 'Outfit', system-ui, sans-serif;
        font-weight: 600;
        color: var(--ceramic-terracotta);
      }
      .note-content hr {
        border: 0;
        height: 1px;
        background: rgba(233, 217, 200, 0.8);
        margin: 1.5rem 0;
      }

      /* ── Tags ── */
      .tag {
        display: inline-block;
        background: rgba(233, 217, 200, 0.6);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-size: 0.78rem;
        color: var(--ceramic-slate);
        border: 1px solid rgba(201, 212, 200, 0.6);
        font-weight: 500;
        transition: all 0.2s;
      }
      .tag:hover {
        background: var(--ceramic-cream);
        color: var(--ceramic-terracotta);
      }

      /* ═══════════════════════════════════════
         Footer — Ceramic
         ═══════════════════════════════════════ */
      footer[data-webcore-footer] {
        border-top: 1px solid rgba(201, 212, 200, 0.6) !important;
        background: #F5EDE4 !important;
        padding: 2.5rem 1rem 1.5rem !important;
      }

      footer[data-webcore-footer] .container {
        max-width: 1100px !important;
        margin: 0 auto !important;
      }

      footer[data-webcore-footer] .wrapper {
        display: flex !important;
        flex-direction: column !important;
        gap: 2rem !important;
      }

      footer[data-webcore-footer] .columns {
        display: flex !important;
        flex-direction: column !important;
        gap: 2rem !important;
      }

      footer[data-webcore-footer] .column-title {
        font-family: 'Outfit', sans-serif !important;
        font-weight: 700 !important;
        font-size: 0.85rem !important;
        color: var(--ceramic-dark) !important;
        margin-bottom: 0.75rem !important;
        display: block !important;
      }

      footer[data-webcore-footer] .column {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      footer[data-webcore-footer] .column li {
        margin-bottom: 0.4rem !important;
      }

      footer[data-webcore-footer] .column a {
        color: var(--ceramic-slate) !important;
        text-decoration: none !important;
        font-size: 0.85rem !important;
        transition: color 0.2s ease !important;
      }

      footer[data-webcore-footer] .column a:hover {
        color: var(--ceramic-terracotta) !important;
        text-decoration: none !important;
      }

      footer[data-webcore-footer] .subtext {
        border-top: 1px solid rgba(201, 212, 200, 0.6) !important;
        margin-top: 2rem !important;
        padding-top: 1.25rem !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 0.5rem !important;
        align-items: center !important;
        text-align: center !important;
      }

      footer[data-webcore-footer] .subtext span {
        font-size: 0.82rem !important;
        color: var(--ceramic-sage) !important;
      }

      @media (min-width: 800px) {
        footer[data-webcore-footer] .wrapper {
          flex-direction: row !important;
          align-items: flex-start !important;
        }
        footer[data-webcore-footer] .columns {
          flex-direction: row !important;
          gap: 3rem !important;
          margin-left: auto !important;
        }
        footer[data-webcore-footer] .subtext {
          flex-direction: row !important;
          justify-content: space-between !important;
          text-align: left !important;
        }
      }

      /* ═══════════════════════════════════════
         Back-to-Top — Terracotta
         ═══════════════════════════════════════ */
      .back-to-top {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--ceramic-terracotta);
        color: white;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(193, 117, 89, 0.3);
        opacity: 0;
        visibility: hidden;
        transform: translateY(12px);
        transition: all 0.3s ease;
        z-index: 50;
      }
      .back-to-top.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      .back-to-top:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(193, 117, 89, 0.4);
      }
      .back-to-top svg {
        width: 20px;
        height: 20px;
      }

      /* ═══════════════════════════════════════
         Scroll Reveal
         ═══════════════════════════════════════ */
      .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      @media (max-width: 640px) {
        main { padding: 1.25rem 1rem; }
        .page-header h1 { font-size: 1.4rem; }
        .back-to-top { bottom: 1.25rem; right: 1.25rem; width: 40px; height: 40px; }
      }
    </style>
  </head>
  <body>
    <!-- WebcoreUI Menu — glassmorphism header + mobile slide-in drawer -->
    <Menu
      logo:html={logoHtml}
      items={menuItems}
      data-webcore-menu
    />

    <main>
      {breadcrumbs && breadcrumbs.length > 0 && (
        <nav class="breadcrumb-nav">
          {breadcrumbs.map((crumb, i) => (
            <>
              {i > 0 && <span class="breadcrumb-sep">▸</span>}
              {crumb.href ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span style="color:var(--ceramic-slate);">{crumb.label}</span>
              )}
            </>
          ))}
        </nav>
      )}

      <div class="page-header">
        <h1>{title}</h1>
        {description && <p style="color:var(--ceramic-sage);margin-top:0.3rem;font-size:0.95rem;">{description}</p>}
      </div>

      <slot />
    </main>

    <!-- WebcoreUI Footer -->
    <Footer
      logo:html={footerLogoHtml}
      columns={footerColumns}
      subText="NotaBelajar — Nota pembelajaran untuk pelajar Malaysia. Dibina dengan Astro + WebcoreUI."
      data-webcore-footer
    />

    <!-- Back-to-Top Button -->
    <button class="back-to-top" id="backToTop" aria-label="Kembali ke atas">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
    </button>

    <script>
      // ── Back-to-Top ──
      const backToTop = document.getElementById('backToTop');
      let ticking = false;

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            backToTop.classList.toggle('visible', window.scrollY > 300);
            ticking = false;
          });
          ticking = true;
        }
      });

      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // ── Scroll Reveal ──
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.addEventListener('astro:after-swap', () => {
        document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
      });

      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    </script>
  </body>
</html>