---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const paths = new Map();
  for (const note of notes) {
    const key = `${note.data.level}/${note.data.subject}`;
    if (!paths.has(key)) paths.set(key, { level: note.data.level, subject: note.data.subject });
  }
  return [...paths.values()].map(({ level, subject }) => ({
    params: { level, subject },
  }));
}

const { level, subject } = Astro.params;
const allNotes = await getCollection('notes');
const filteredNotes = allNotes.filter(n => n.data.level === level && n.data.subject === subject);

const levelName = level === 'sk' ? 'Sekolah Rendah' : 'Sekolah Menengah';
const levelLabel = level === 'sk' ? 'SK' : 'SMK';
const levelBadge = level === 'sk' ? 'var(--ceramic-teal)' : 'var(--ceramic-mauve)';
const subjectName = subject.charAt(0).toUpperCase() + subject.slice(1).replace(/-/g, ' ');

const byYear = {};
for (const note of filteredNotes) {
  const year = note.data.year;
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(note);
}
const years = Object.keys(byYear).sort();

const levelPath = level === 'sk' ? 'sk' : 'smk';
---

<BaseLayout
  title={`${subjectName} — ${levelName} — NotaBelajar`}
  breadcrumbs={[
    { label: 'Laman Utama', href: '/notabelajar/' },
    { label: levelName, href: `/notabelajar/${levelPath}` },
    { label: subjectName },
  ]}
>
  <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:1.5rem;">
    <span style="display:inline-flex;align-items:center;gap:0.3rem;padding:0.2rem 0.6rem;border-radius:6px;font-size:0.8rem;font-weight:600;color:white;background:{levelBadge};">
      {levelLabel}
    </span>
    <span style="font-size:0.9rem;color:var(--ceramic-sage);">
      {filteredNotes.length} nota
    </span>
  </div>

  {years.map(year => (
    <div style="margin-bottom:2rem;">
      <h2 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:1.15rem;padding-bottom:0.5rem;border-bottom:2px solid var(--ceramic-cream);margin-bottom:0.75rem;color:var(--ceramic-dark);">
        {level === 'sk' ? `Tahun ${year}` : `Tingkatan ${year}`}
      </h2>

      <div style="display:flex;flex-direction:column;gap:0.6rem;">
        {byYear[year].map(note => (
          <a href={`/notabelajar/${note.id}`} class="note-item">
            <div style="flex:1;">
              <div class="note-item-title">{note.data.title}</div>
              <div class="note-item-meta">{note.data.topic}</div>
            </div>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;color:var(--ceramic-sage);">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  ))}

  {filteredNotes.length === 0 && (
    <p style="color:var(--ceramic-sage);text-align:center;padding:3rem 0;background:rgba(255,255,255,0.6);border-radius:12px;border:1px solid rgba(201,212,200,0.6);">
      Belum ada nota untuk subjek ini. Nota akan ditambah dari masa ke semasa.
    </p>
  )}

  <div style="margin-top:2rem;">
    <a href={`/notabelajar/${levelPath}`} style="color:var(--ceramic-slate);text-decoration:none;font-weight:500;font-size:0.9rem;">
      ← Kembali ke {levelName}
    </a>
  </div>

  <style>
    .note-item {
      display: flex;
      align-items: center;
      background: rgba(255,255,255,0.6);
      border: 1px solid rgba(201,212,200,0.6);
      border-radius: 10px;
      padding: 0.85rem 1rem;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .note-item:hover {
      border-color: var(--ceramic-terracotta);
      box-shadow: 0 2px 8px rgba(193,117,89,0.1);
    }
    .note-item-title {
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--ceramic-dark);
    }
    .note-item-meta {
      font-size: 0.82rem;
      color: var(--ceramic-sage);
      margin-top: 0.15rem;
    }
  </style>
</BaseLayout>