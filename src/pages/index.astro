---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const skCount = allNotes.filter(n => n.data.level === 'sk').length;
const smkCount = allNotes.filter(n => n.data.level === 'smk').length;
const subjectCount = [...new Set(allNotes.map(n => n.data.subject))].length;
---

<BaseLayout title="Laman Utama">
  <div style="text-align:center;padding:2rem 0 3rem;">
    <h1 style="font-size:2.5rem;">📝 NotaBelajar</h1>
    <p style="font-size:1.1rem;color:var(--text-muted);max-width:600px;margin:1rem auto;">
      Koleksi nota pembelajaran untuk pelajar sekolah rendah (SK) dan menengah (SMK) Malaysia.
      Dikemaskini secara berkala.
    </p>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:3rem;">
    <a href="/notabelajar/sk" class="card" style="border-left:4px solid var(--sk-color);">
      <h2>Sekolah Rendah (SK)</h2>
      <p style="color:var(--text-muted);margin-top:0.5rem;">
        Nota untuk Tahun 1 hingga Tahun 6
      </p>
      <div class="meta" style="margin-top:0.75rem;">
        <span class="level-badge sk">SK</span>
        <span style="margin-left:0.5rem;">{skCount} nota</span>
      </div>
    </a>

    <a href="/notabelajar/smk" class="card" style="border-left:4px solid var(--smk-color);">
      <h2>Sekolah Menengah (SMK)</h2>
      <p style="color:var(--text-muted);margin-top:0.5rem;">
        Nota untuk Tingkatan 1 hingga Tingkatan 5
      </p>
      <div class="meta" style="margin-top:0.75rem;">
        <span class="level-badge smk">SMK</span>
        <span style="margin-left:0.5rem;">{smkCount} nota</span>
      </div>
    </a>
  </div>

  <div style="text-align:center;color:var(--text-muted);font-size:0.9rem;">
    <p>{subjectCount} subjek — {skCount + smkCount} nota</p>
  </div>
</BaseLayout>